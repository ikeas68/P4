<Window x:Class="Puissance4Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Puissance 4" Height="720" Width="640" Background="#062B40" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="20" Padding="16" Background="#0B4F6C" CornerRadius="12" BorderBrush="#1894C4" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect Color="#001018" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <DockPanel>
                <TextBlock Text="Puissance 4" FontSize="28" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Difficulté" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="DifficultyBox" Width="140" SelectionChanged="DifficultyBox_OnSelectionChanged">
                        <ComboBoxItem Content="1 - Débutant" Tag="1" />
                        <ComboBoxItem Content="2 - Intermédiaire" Tag="2" />
                        <ComboBoxItem Content="3 - Avancé" Tag="3" />
                        <ComboBoxItem Content="4 - Expert" Tag="4" />
                    </ComboBox>
                    <Button Content="Nouvelle partie" Style="{StaticResource BoardButton}" Click="RestartButton_OnClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="40,0,40,10" Height="44" CornerRadius="10" Background="#0B4F6C" BorderBrush="#1894C4" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect Color="#001018" BlurRadius="16" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>
            <Grid>
                <Canvas x:Name="IndicatorCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="42" Margin="10,0">
                    <Polygon x:Name="ColumnIndicator" Fill="#FFE066" Stroke="#F7C948" StrokeThickness="2" Points="0,0 36,0 18,26" />
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="40,0,40,20">
            <Border Background="{StaticResource BoardBaseBrush}" CornerRadius="24" Padding="24" BorderBrush="#0D6BA8" BorderThickness="4">
                <Border.Effect>
                    <DropShadowEffect Color="#000A12" BlurRadius="34" ShadowDepth="0" Opacity="0.55" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#0A3D58" CornerRadius="18" />
                    <Canvas x:Name="BoardCanvas" Background="Transparent" ClipToBounds="True" />
                    <Grid Margin="10" x:Name="SlotGrid" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Button Content="◀" Width="60" Style="{StaticResource BoardButton}" Click="LeftButton_OnClick" />
            <Button Content="Laisser tomber" Width="160" Style="{StaticResource BoardButton}" Click="DropButton_OnClick" />
            <Button Content="▶" Width="60" Style="{StaticResource BoardButton}" Click="RightButton_OnClick" />
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="20" FontSize="16" Foreground="White" Text="Choisissez une colonne pour commencer." TextAlignment="Center" />
    </Grid>
</Window>
