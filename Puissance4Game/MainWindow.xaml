<Window x:Class="Puissance4Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Puissance4Game"
        Title="Puissance 4"
        Height="720"
        Width="640"
        Background="#062B40"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- name -->
        <Border Grid.Row="0"
                Margin="20"
                Padding="16"
                Background="#0B4F6C"
                CornerRadius="12"
                BorderBrush="#1894C4"
                BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect Color="#001018"
                                  BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.5" />
            </Border.Effect>
            <DockPanel>
                <TextBlock Text="Puissance 4"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Difficulté"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="DifficultyBox"
                              Width="140"
                              Background="White"
                              Foreground="Black"
                              VerticalContentAlignment="center"
                              SelectionChanged="DifficultyBox_OnSelectionChanged">
                        <ComboBoxItem Content="1 - Débutant"
                                      Tag="1" />
                        <ComboBoxItem Content="2 - Intermédiaire"
                                      Tag="2" />
                        <ComboBoxItem Content="3 - Avancé"
                                      Tag="3" />
                        <ComboBoxItem Content="4 - Expert"
                                      Tag="4" />
                    </ComboBox>
                    <Button Content="Nouvelle partie"
                            Style="{StaticResource BoardButton}"
                            Width="150"
                            Height="{Binding ActualHeight, ElementName=DifficultyBox}"
                            Click="RestartButton_OnClick" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- panel -->
        <Grid Grid.Row="2"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Width="544"
              Height="474">
            <Border Background="{StaticResource BoardBaseBrush}"
                    CornerRadius="24"
                    Padding="24"
                    BorderBrush="#0D6BA8"
                    BorderThickness="5">
                <Border.Effect>
                    <DropShadowEffect Color="#000A12"
                                      BlurRadius="34"
                                      ShadowDepth="0"
                                      Opacity="0.55" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="back"
                        Background="CornflowerBlue"
                            CornerRadius="18" />
                    <Canvas x:Name="BoardCanvas"
                            Background="Transparent"
                            ClipToBounds="True"
                            MouseMove="SelectionCanvas_OnMouseMove"
                            MouseLeave="SelectionCanvas_OnMouseLeave"
                            MouseEnter="SelectionCanvas_OnMouseEnter"
                            MouseLeftButtonUp="SelectionCanvas_OnMouseLeftButtonUp"
                            Cursor="Hand" />
                    <Path x:Name="BoardFrontPath"
                          Fill="#155DA8"
                          Stroke="#0D3C70"
                          StrokeThickness="6"
                          IsHitTestVisible="False" />
                    <Grid x:Name="SlotGrid"
                          IsHitTestVisible="False"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <local:GridBoard SelectedTemplate="2"
                                     Background="Transparent"
                                     IsHitTestVisible="False"
                                     Visibility="Visible">
                        <local:GridBoard.Templates>
                            <DataTemplate>
                                <Border CornerRadius="10"
                                        Background="CornflowerBlue" />
                            </DataTemplate>
                            <DataTemplate>
                                <Ellipse StrokeThickness="2"
                                         Stroke="White"
                                         Fill="Gold" />
                            </DataTemplate>
                            <DataTemplate>
                                <Border Margin="-1"
                                        Background="{StaticResource BoardBaseBrush}"           >
                                    <Border.OpacityMask>
                                        <VisualBrush Stretch="Fill">
                                            <VisualBrush.Visual>
                                                <!-- Masque blanc = visible, trou = transparent -->
                                                <Path Stretch="Fill"
                                                      Fill="White">
                                                    <Path.Data>
                                                        <GeometryGroup FillRule="EvenOdd">
                                                            <RectangleGeometry Rect="0,0,100,100" />
                                                            <EllipseGeometry Center="50,50"
                                                                             RadiusX="40"
                                                                             RadiusY="40" />
                                                        </GeometryGroup>
                                                    </Path.Data>
                                                </Path>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </DataTemplate>
                        </local:GridBoard.Templates>
                    </local:GridBoard>
                </Grid>
            </Border>
        </Grid>
        <!-- indicator -->
        <Canvas x:Name="IndicatorCanvas"
                Grid.Row="1"
                Width="544"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                MouseMove="SelectionCanvas_OnMouseMove"
                MouseLeave="SelectionCanvas_OnMouseLeave"
                MouseEnter="SelectionCanvas_OnMouseEnter"
                MouseLeftButtonUp="SelectionCanvas_OnMouseLeftButtonUp"
                Visibility="Collapsed"
                Cursor="Hand">
            <Polygon x:Name="ColumnIndicator"
                     Fill="#FFE066"
                     Stroke="#F7C948"
                     StrokeThickness="2"
                     Points="0,0 90,0 45,70" />
        </Canvas>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
            <Button Content="◀"
                    Width="60"
                    Style="{StaticResource BoardButton}"
                    Click="LeftButton_OnClick" />
            <Button Content="Laisser tomber"
                    Width="160"
                    Style="{StaticResource BoardButton}"
                    Click="DropButton_OnClick" />
            <Button Content="▶"
                    Width="60"
                    Style="{StaticResource BoardButton}"
                    Click="RightButton_OnClick" />
        </StackPanel>
        <!-- text bottom -->
        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Margin="20"
                   FontSize="16"
                   Foreground="White"
                   Text="Choisissez une colonne pour commencer."
                   TextAlignment="Center" />
        <TextBlock Grid.Row="4"
                   x:Name="VersionTextBlock"
                   Margin="0,0,16,12"
                   FontSize="12"
                   Foreground="#B3FFFFFF"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom" />
    </Grid>
</Window>
